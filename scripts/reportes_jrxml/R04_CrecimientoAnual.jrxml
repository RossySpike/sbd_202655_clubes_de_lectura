	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Clubes de Lectura"/>
	<parameter name="P_ID_CLUB" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ID_PAIS" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TIPO_CLUB" class="java.lang.String">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ANIO_DESDE" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ANIO_HASTA" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[
SELECT *
FROM   MJV_vw_r4_consolidado
WHERE  ($P{P_ID_CLUB}    IS NULL OR id_club    = $P{P_ID_CLUB})
  AND  ($P{P_ID_PAIS}    IS NULL OR id_pais    = $P{P_ID_PAIS})
  AND  ($P{P_TIPO_CLUB}  IS NULL OR tipo_club  = $P{P_TIPO_CLUB})
  AND  ($P{P_ANIO_DESDE} IS NULL OR anio      >= $P{P_ANIO_DESDE})
  AND  ($P{P_ANIO_HASTA} IS NULL OR anio      <= $P{P_ANIO_HASTA})
ORDER BY nombre_club ASC, anio ASC
	]]></query>
