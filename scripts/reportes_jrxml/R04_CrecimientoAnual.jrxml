		<element kind="textField" uuid="d4000004-0004-4004-d004-400000000076" x="15" y="67" width="772" height="14" forecolor="#0F766E" fontSize="7.5" bold="true" vTextAlign="Middle">
			<expression><![CDATA[
"Filtros activos:  " +
($P{P_ID_CLUB}    != null ? "Club ID=" + $P{P_ID_CLUB} + "  " : "") +
($P{P_ID_PAIS}    != null ? "País ID=" + $P{P_ID_PAIS} + "  " : "") +
($P{P_TIPO_CLUB}  != null && !$P{P_TIPO_CLUB}.isEmpty() ? "Tipo=" + $P{P_TIPO_CLUB} + "  " : "") +
($P{P_ANIO_DESDE} != null ? "Desde=" + $P{P_ANIO_DESDE} + "  " : "") +
($P{P_ANIO_HASTA} != null ? "Hasta=" + $P{P_ANIO_HASTA} + "  " : "") +
($P{P_ID_CLUB} == null && $P{P_ID_PAIS} == null &&
 ($P{P_TIPO_CLUB} == null || $P{P_TIPO_CLUB}.isEmpty()) &&
 $P{P_ANIO_DESDE} == null && $P{P_ANIO_HASTA} == null ? "Todos los clubes activos (sin filtro)" : "")
			]]></expression>
		</element>
	</title>
