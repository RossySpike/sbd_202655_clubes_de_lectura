<jasperReport name="R03_FichaLibro" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c3000003-0003-4003-c003-300000000003">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Clubes de Lectura"/>
	<parameter name="P_ISBN" class="java.lang.String">
		<defaultValueExpression><![CDATA["978-0-06-112008-4"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[
SELECT
    fl.isbn,
    fl.titulo,
    fl.tipo_narrativa,
    fl.sinopsis,
    fl.genero,
    fl.primera_edicion,
    fl.total_paginas,
    fl.pais_origen,
    fl.autores,
    fl.valoracion_global,
    ag.id_club,
    ag.nombre_club,
    ag.pais_club,
    ag.ciudad_club,
    ag.id_grupo,
    ag.tipo_grupo,
    ag.valoracion              AS valoracion_grupo,
    ag.conclusiones,
    TO_CHAR(ag.fecha_cierre, 'DD/MM/YYYY')  AS fecha_cierre,
    ag.nombre_moderador
FROM
    MJV_vw_r3_ficha_libro            fl
    LEFT JOIN MJV_vw_r3_analisis_por_grupo ag ON ag.isbn = fl.isbn
WHERE
    fl.isbn = $P{P_ISBN}
ORDER BY
    ag.valoracion DESC NULLS LAST,
    ag.fecha_cierre DESC NULLS LAST
    ]]></query>
